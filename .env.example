# Free transcription key from https://console.groq.com/keys (no card needed).
# Leave blank to transcribe on your own computer instead (needs Python and: pip install faster-whisper).
GROQ_API_KEY=

# AI Provider for scene planning (if using AI-assisted planning)
# Options: groq, anthropic, openai
AI_PROVIDER=groq

# Provider API keys (only fill the one you're using)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
