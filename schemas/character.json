{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Character Asset Registration",
  "type": "object",
  "required": ["id", "name", "path", "type"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "type": { "type": "string", "enum": ["svg", "png", "gif"] },
    "path": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "defaultScale": { "type": "number", "default": 1.0 },
    "boundingBox": {
      "type": "object",
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    }
  }
}
