{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scene Plan",
  "type": "object",
  "required": ["projectId", "version", "scenes", "totalDuration"],
  "properties": {
    "projectId": { "type": "string" },
    "version": { "type": "string", "default": "1.0.0" },
    "created": { "type": "string", "format": "date-time" },
    "updated": { "type": "string", "format": "date-time" },
    "totalDuration": { "type": "number" },
    "scenes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assetUsage": {
      "type": "object",
      "description": "Summary of which assets are used in which scenes"
    }
  }
}
